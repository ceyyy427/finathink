  "decisions": [
    "借鉴 QUANTAXIS 面板、日历与滚动算子结构，独立实现时点选择与规则合同。",
    "DeepSeek 指标的缺高低价近似不进入本实现；保留明确缺失。",
    "Qlib 训练期拟合与截面变换分开；本实现固定 ddof=0、独立数值边界与训练摘要。",
    "Pyanomaly 的资产隔离与财务口径作为阅读参考，不引入数据商 SDK。"
  ],
  "dependencies": "No new runtime dependencies; existing numpy/pandas only; no upstream code copied."
}

    {
      "template_id": "equal-weight",
      "version": "1.0.0",
      "title": "等权基准",
      "universe": "all",
      "required_fields": [
        "close",
        "in_universe",
        "is_session"
      ],
      "selection_rule": "在当期已知可纳入资产间等权。",
      "weight_rule": "单资产上限与现金保留。",
      "rebalance_rule": "按声明观察点间隔检查并冻结目标权重。",
      "execution_mode": "PAPER_LONG_ONLY",
      "execution_rule": "最早下一观察点执行，受现金、交易许可、整手、结算及价格限制约束。",
      "benchmark": {
        "kind": "equal-weight-buy-hold",
        "universe": "all",
        "cost_basis": "frictionless"
      },
      "risk_rules": [
        "data-pit",
        "financial-abnormality",
        "tradeability",
        "liquidity",
        "concentration",
        "industry",
        "collinearity",
        "volatility",
        "tail-loss",
        "stop-loss",
        "drawdown",
        "stress"
      ],
      "failure_scenario": "未知交易日或资产池成员需补证据。",
      "parameter_bounds": {
        "rebalance_every": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 5
        },
        "starting_cash": {
          "type": "number",
          "minimum": 100,
          "maximum": 1000000,
          "default": 10000
        },
        "fee_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 5
        },
        "slippage_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 5
        },
        "cash_buffer": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.9,
          "default": 0.1
        },
        "max_weight": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.5,
          "default": 0.5
        }
      },
      "source_refs": [
